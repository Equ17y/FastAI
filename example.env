# Режим отладки (true или false)
DEBUG=true

# Секретный ключ приложения
SECRET_KEY=your_secret_key_here

# Настройки DeepSeek (или альтернативной инсталляции, например, BotHub)
DEEPSEEK__API_KEY=your_deepseek_api_key_here
DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
DEEPSEEK__MAX_CONNECTIONS=5
DEEPSEEK__TIMEOUT=30

# Настройки Unsplash
UNSPLASH__API_KEY=your_unsplash_access_key_here
UNSPLASH__MAX_CONNECTIONS=5
UNSPLASH__TIMEOUT=20

# Настройки S3 / MinIO
AWS__ACCESS_KEY=minioadmin
AWS__SECRET_KEY=minioadmin123
AWS__ENDPOINT_URL=http://127.0.0.1:9000
AWS__BUCKET_NAME=fastai-sites
AWS__CONNECT_TIMEOUT=5
AWS__READ_TIMEOUT=30
AWS__MAX_CONNECTIONS=10

# Настройки Gotenberg
GOTENBERG__API_URL=https://demo.gotenberg.dev
GOTENBERG__SCREENSHOT_WIDTH=1280
GOTENBERG__IMAGE_FORMAT=png
GOTENBERG__MAX_CONNECTIONS=5
GOTENBERG__TIMEOUT=10
GOTENBERG__WAIT_DELAY=8
